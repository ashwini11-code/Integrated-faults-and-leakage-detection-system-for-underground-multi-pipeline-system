// -------------------- PIN DEFINITION --------------------
const int FLOW_WATER_PIN = 18;   // Water flow sensor pulse pin
const int FLOW_GAS_PIN   = 5;  // Gas flow sensor pulse pin

const int MQ_PIN         = 34;  // MQ gas sensor (analog)
const int LDR_PIN        = 35;  // LDR crack detector (analog)
const int CURRENT_PIN    = 32;  // ACS712 current sensor (analog)




int phsensor=36;

unsigned long int avgValue;  //Store the average value of the sensor feedback
float b;
int buf[10],temp;

float pHValue = 0;
unsigned long lastPhDisplay = 0;
