// -------------------- MAIN LOOP --------------------
void loop() 
{
  unsigned long now = millis();

  // FLOW SENSOR SAMPLE EVERY 1 SEC
  if (now - lastFlowSampleMillis >= FLOW_SAMPLE_MS) 
  {
    noInterrupts();
    unsigned long w = waterPulseCount;
    unsigned long g = gasPulseCount;
    waterPulseCount = 0;
    gasPulseCount = 0;
    interrupts();

    waterLpm = pulsesToLpm(w, CALIB_FLOW_WATER);
    gasLpm   = pulsesToLpm(g, CALIB_FLOW_GAS);

    lastFlowSampleMillis = now;

    Serial.print("Water LPM: "); Serial.println(waterLpm);
    Serial.print("Gas LPM: "); Serial.println(gasLpm);
  }

  // READ SENSORS
  float mqRaw = analogRead(MQ_PIN);
  int ldrRaw = analogRead(LDR_PIN);
  float curA = getCurrentA();

 int p=analogRead(36);
  p=4095-p;
  pHValue = map(p, 0, 4095, 0, 14);
   Serial.print("pHValue:");  
  Serial.print(pHValue);
  Serial.println("");
//   // show pH for 1 second every loop
//  showPh = true;
//  lastPhDisplay = now;

 
  
  Serial.println("Gas:"+String(mqRaw));
  Serial.println("LDR:"+String(ldrRaw));
  Serial.println("Current:"+String(curA));
  
  delay(1000);

  if(digitalRead(Switch)==LOW)
  {
    
     lcd.clear();
    lcd.print("Electricity ");
    lcd.setCursor(0,1);
    lcd.print("Fault Occured..");
    Serial.println("Electricity Fault Detected");
    elecFault=1;
    delay(1000);
  }
  else
  {
     elecFault=0;
  }
  if(mqRaw > MQ_THRESHOLD)
  {
    lcd.clear();
    lcd.print("Gas Leakage ");
    lcd.setCursor(0,1);
    lcd.print("Detected..");
    Serial.println("Gas Leakage Detected");
    delay(1000);
  }
  // DETECTION LOGIC
  waterFault = (waterLpm < 0.2);
  gasFlowFault = (gasLpm < 0.2);
  //gasLeak = (mqRaw > MQ_THRESHOLD);
  opticalFault = (ldrRaw < LDR_THRESHOLD);
//  elecFault = (curA > CURRENT_THRESHOLD_A);
elecFault=(elecFault==1);

  anyFault = waterFault || gasFlowFault || gasLeak || opticalFault || elecFault;

  // ALARM HANDLING
  if (anyFault) 
  {
    digitalWrite(BUZZER_PIN, HIGH);
  delay(500);
  } 
  else 
  {
    digitalWrite(BUZZER_PIN, LOW);
 
  }

  LCD_Display();
