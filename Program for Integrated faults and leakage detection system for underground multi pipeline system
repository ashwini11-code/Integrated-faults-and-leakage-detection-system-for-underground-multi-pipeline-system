const int BUZZER_PIN     = 2;   // Buzzer output
const int Switch      = 15;  // Relay output


int R1=17;  //Water
int G1=16;

int R2=23;  //Gas
int G2=19;

int R3=21;  //Electricity
int G3=22;

int R4=4;  // Optical
int G4=33;


// -------------------- FLOW SENSOR CALIBRATION --------------------
volatile unsigned long waterPulseCount = 0;
volatile unsigned long gasPulseCount = 0;

const float CALIB_FLOW_WATER = 7.5; 
const float CALIB_FLOW_GAS   = 7.5;

const unsigned long FLOW_SAMPLE_MS = 1000; // 1 sec sample interval

unsigned long lastFlowSampleMillis = 0;
unsigned long lastLCDMillis = 0;

// -------------------- ADC THRESHOLDS --------------------
const float MQ_THRESHOLD = 3000.0;  // Gas leak threshold (tune)
const int LDR_THRESHOLD  = 1200;    // Light loss → crack
//const float CURRENT_THRESHOLD_A = 1.0; // Electric fault threshold (tune)

// -------------------- ADC SETTINGS --------------------
const float ADC_REF_VOLT = 3.3;
const int ADC_MAX = 4095;
const float ACS712_SENSITIVITY = 0.185; // V per A (for ACS712-5A)
const float ACS712_ZERO = 1.65;         // mid voltage for ACS712

// -------------------- FLOW VALUES --------------------
float waterLpm = 0.0;
float gasLpm   = 0.0;


  // DETECTION LOGIC
  float waterFault;
  float gasFlowFault ;
  float gasLeak ;
  float opticalFault;
  float elecFault;

  float anyFault ;




// -------------------- INTERRUPTS --------------------
void IRAM_ATTR waterISR() {
  waterPulseCount++;
}

void IRAM_ATTR gasISR() {
  gasPulseCount++;
}

// -------------------- SETUP --------------------
void setup() 
{
  Serial.begin(9600);

  pinMode(FLOW_WATER_PIN, INPUT_PULLUP);
  pinMode(FLOW_GAS_PIN, INPUT_PULLUP);

    pinMode(R1, OUTPUT);
  pinMode(G1, OUTPUT);
  
    pinMode(R2, OUTPUT);
  pinMode(G2, OUTPUT);
  
    pinMode(R3, OUTPUT);
  pinMode(G3, OUTPUT);
  
    pinMode(R4, OUTPUT);
  pinMode(G4, OUTPUT);

  pinMode(BUZZER_PIN, OUTPUT);
  pinMode(Switch, INPUT_PULLUP);
  digitalWrite(BUZZER_PIN, LOW);
 

    digitalWrite(R1, LOW);
  digitalWrite(G1, HIGH);
  
    digitalWrite(R2, LOW);
  digitalWrite(G2, HIGH);
  
    digitalWrite(R3, LOW);
  digitalWrite(G3, HIGH);
  
    digitalWrite(R4, LOW);
  digitalWrite(G4, HIGH);
  

  attachInterrupt(digitalPinToInterrupt(FLOW_WATER_PIN), waterISR, RISING);
  attachInterrupt(digitalPinToInterrupt(FLOW_GAS_PIN), gasISR, RISING);

  lcd.begin(16,2);
  lcd.print("Multi-Pipe Sys");
  lcd.setCursor(0,1);
  lcd.print("Initializing...");
  delay(1500);
  lcd.clear();
}

// -------------------- SENSOR FUNCTIONS --------------------
float getCurrentA() 
{
  int adc = analogRead(CURRENT_PIN);
  float voltage = (adc * ADC_REF_VOLT) / ADC_MAX;
  float diff = voltage - ACS712_ZERO;
  return fabs(diff / ACS712_SENSITIVITY);
}

// -------------------- FLOW CONVERSION --------------------
float pulsesToLpm(unsigned long pulses, float calib) 
{
  float pps = pulses / 1.0;  // pulses per second
  return pps / calib;
}

